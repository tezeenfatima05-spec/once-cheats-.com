---
import type { ProductPage } from '../../data/products';
import Icon from '../icons/Icon.astro';
import ProductIconWell from './ProductIconWell.astro';
import { Button } from '@/components/starwind/button';
import { CHECKOUT_LINK_REL } from '../../config/checkout';

interface Props {
  product: ProductPage;
  addonCheckout?: { label: string; href: string }[];
}

const { product, addonCheckout = [] } = Astro.props;

const highlightFeatures = product.fullFeatures.slice(0, 6);
---

<aside
  class="product-checkout text-left lg:sticky lg:top-24"
  aria-labelledby={`checkout-${product.slug}`}
  data-product-checkout
>
  <div class="overflow-hidden rounded-2xl border border-primary/35 bg-card shadow-md ring-1 ring-primary/15">
    <div class="card-title-band flex items-center justify-start gap-3 px-5 py-4 text-left">
      <ProductIconWell name="acqPackage" iconSize={20} class="bg-primary/15" />
      <div class="min-w-0 text-left">
        <p class="text-xs font-medium uppercase tracking-wider text-muted-foreground">Product features</p>
        <h2 id={`checkout-${product.slug}`} class="text-base font-semibold leading-snug">
          Explore what&apos;s included
        </h2>
      </div>
    </div>

    <div class="space-y-5 px-5 pb-5 pt-5">
      <ul class="space-y-2.5 text-sm text-foreground" aria-label={`${product.name} feature highlights`}>
        {
          highlightFeatures.map((feature) => (
            <li class="flex items-start gap-2.5">
              <Icon name="check" size={16} class="mt-0.5 shrink-0 text-primary" aria-hidden="true" />
              <span>{feature}</span>
            </li>
          ))
        }
      </ul>

      <Button
        as="a"
        href={product.buyUrl}
        rel={CHECKOUT_LINK_REL}
        variant="primary"
        size="lg"
        class="w-full rounded-xl"
        data-checkout-buy
      >
        Proceed to Checkout →
        <Icon name="arrowRight" size={17} />
      </Button>

      {
        addonCheckout.length > 0 && (
          <div class="space-y-2 border-t border-border pt-4">
            <p class="text-xs font-medium uppercase tracking-wider text-muted-foreground">Add-ons</p>
            {addonCheckout.map((addon) => (
              <Button
                as="a"
                href={addon.href}
                rel={CHECKOUT_LINK_REL}
                variant="outline"
                size="default"
                class="w-full rounded-xl justify-between"
              >
                {addon.label}
                <Icon name="arrowRight" size={16} />
              </Button>
            ))}
          </div>
        )
      }
    </div>
  </div>
</aside>
{
  "name": "site",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/optimize-images.mjs && astro build && node scripts/prune-dist-images.mjs && node scripts/finalize-sitemap.mjs && node scripts/verify-sitemap-domain.mjs && node scripts/indexnow.mjs && node scripts/generate-seo-baseline.mjs && node scripts/audit-content.mjs && node scripts/qa-checklist.mjs && node scripts/check-leftovers.mjs && node scripts/check-seo.mjs",
    "preview": "astro preview --host 0.0.0.0",
    "start": "node scripts/serve.mjs",
    "astro": "astro",
    "optimize:images": "node scripts/optimize-images.mjs",
    "check:leftovers": "node scripts/check-leftovers.mjs",
    "check:seo": "node scripts/check-seo.mjs",
    "check:all": "node scripts/audit-content.mjs && node scripts/qa-checklist.mjs && node scripts/check-leftovers.mjs && node scripts/check-seo.mjs",
    "seo:baseline": "node scripts/generate-seo-baseline.mjs",
    "brand:previews": "node scripts/generate-brand-previews.mjs",
    "favicon:generate": "node scripts/generate-favicon-from-asset.mjs",
    "deploy": "npm run build && wrangler deploy",
    "preview:cf": "npm run build && wrangler dev"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@lucide/astro": "^1.48.0",
    "@starwind-ui/astro": "^1.2.1",
    "@tabler/icons": "^3.48.0",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.1.1",
    "embla-carousel-autoplay": "^8.6.0",
    "sharp": "^0.34.3",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@astrojs/cloudflare": "^14.4.8",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.2",
    "wrangler": "^4.162.0"
  }
}
